user nginx;
worker_processes 1;
pid /tmp/nginx.pid;
# Request URLs can contain short-lived WebSocket tickets.
error_log /dev/null;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    sendfile on;
    tcp_nodelay on;
    keepalive_timeout 65s;
    client_max_body_size 20m;
    client_body_temp_path /tmp/nginx/client_body;
    proxy_temp_path /tmp/nginx/proxy;
    fastcgi_temp_path /tmp/nginx/fastcgi;
    uwsgi_temp_path /tmp/nginx/uwsgi;
    scgi_temp_path /tmp/nginx/scgi;

    # This OpenWrt host uses Docker's default bridge. Use reachable resolvers
    # directly; that network does not provide the 127.0.0.11 DNS stub.
    resolver 223.5.5.5 119.29.29.29 valid=60s ipv6=off;
    resolver_timeout 5s;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    server {
        listen 127.0.0.1:18080;
        location = /health { default_type text/plain; return 200 'ok\n'; }
        location / { return 404; }
    }

    server {
        listen 15555 ssl;
        server_name ${RELAY_HOST};
        error_page 497 =301 https://${RELAY_HOST}:5555$request_uri;
        ssl_certificate /tmp/webspeak-tls/fullchain.pem;
        ssl_certificate_key /tmp/webspeak-tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:WebSpeakRelayTLS:2m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        location / {
            set $webspeak_origin https://${UPSTREAM_HOST}:5555;
            proxy_pass $webspeak_origin;
            proxy_http_version 1.1;
            # Keep browser Origin and Host consistent, including the public port.
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_ssl_server_name on;
            proxy_ssl_name ${UPSTREAM_HOST};
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 3;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_ssl_session_reuse on;
            proxy_connect_timeout 5s;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cookie_flags webspeak_admin secure;
        }
    }
}

stream {
    resolver 223.5.5.5 119.29.29.29 valid=60s ipv6=off;
    resolver_timeout 5s;
    # Every UDP client gets its own upstream socket. Keep asynchronous replies
    # and long-lived TS sessions; DNS changes take effect on a new session.
    server {
        listen 19987 udp reuseport;
        set $teamspeak_origin ${UPSTREAM_HOST}:9987;
        proxy_pass $teamspeak_origin;
        proxy_requests 0;
        # Do not set proxy_responses: TS sends unsolicited voice/keepalive data.
        proxy_timeout 10m;
        proxy_buffer_size 16k;
    }
}
