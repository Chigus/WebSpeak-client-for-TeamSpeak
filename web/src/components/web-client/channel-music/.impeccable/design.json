      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"频道音乐\"><button role=\"tab\" aria-selected=\"true\">搜索</button><button role=\"tab\" tabindex=\"-1\" aria-selected=\"false\">队列</button><button role=\"tab\" tabindex=\"-1\" aria-selected=\"false\">歌单</button></div>",
      "css": ".ds-tabs{display:flex;gap:18px;border-bottom:1px solid var(--border,#e4ece9)}.ds-tabs button{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:8px 0 10px;border:0;border-radius:0;background:transparent;color:var(--text-primary,#192120);font:inherit;font-size:13px;cursor:pointer}.ds-tabs button:hover{background:var(--surface-2,#f1f6f4)}.ds-tabs button[aria-selected=true]{color:var(--accent,#006a64);box-shadow:0 2px 0 var(--accent,#006a64)}.ds-tabs button:focus-visible{outline:2px solid var(--accent,#006a64);outline-offset:3px}@media(max-width:600px){.ds-tabs{gap:20px}.ds-tabs button{min-height:44px}}"
    },
