      "html": "<button class=\"ds-btn ds-play\" aria-label=\"播放\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m8 5 11 7-11 7z\"/></svg></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:7px 9px;border:1px solid var(--border,#e4ece9);border-radius:7px;background:transparent;color:var(--text-primary,#192120);font:inherit;cursor:pointer}.ds-btn:hover:not(:disabled){background:var(--surface-2,#f1f6f4)}.ds-btn:focus-visible{outline:2px solid var(--accent,#006a64);outline-offset:3px}.ds-btn:disabled{opacity:.45;cursor:default}@media(max-width:600px){.ds-btn{min-height:44px}}.ds-play{color:var(--accent,#006a64);background:var(--surface-2,#f1f6f4);width:40px;height:40px;border:0}@media(max-width:600px){.ds-play{width:36px;height:36px}}"
    },
    {
      "name": "搜索输入",
      "kind": "input",
      "refersTo": "search-input",
      "description": "输入关键词；歌单 URL 输入沿用相同表面与轮廓。",
      "html": "<input class=\"ds-input\" type=\"search\" aria-label=\"歌曲或歌手\" placeholder=\"歌曲或歌手\"/>",
      "css": ".ds-input{border:1px solid var(--border,#e4ece9);border-radius:7px;background:var(--surface-1,#fff);padding:9px;min-width:0;font:inherit;font-size:13px;color:var(--text-primary,#192120);caret-color:var(--accent,#006a64)}.ds-input::placeholder{color:color-mix(in srgb,var(--text-primary,#192120) 82%,var(--surface-1,#fff))}.ds-input:focus-visible{outline:2px solid var(--accent,#006a64);outline-offset:3px}@media(max-width:600px){.ds-input{font-size:16px}}"
    },
    {
