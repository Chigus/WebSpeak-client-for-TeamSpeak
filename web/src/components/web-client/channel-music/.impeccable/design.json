      "html": "<section class=\"ds-panel\" aria-label=\"频道音乐\"><div class=\"ds-summary\"><strong>频道音乐</strong><span>同频道共享播放</span></div></section>",
      "css": ".ds-panel{border:1px solid var(--border,#e4ece9);border-radius:12px;background:var(--surface-1,#fff);color:var(--text-primary,#192120);overflow:hidden;min-width:0;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-summary{display:grid;gap:3px;padding:15px 16px}.ds-summary strong{font-size:14px}.ds-summary span{font-size:12px;color:color-mix(in srgb,var(--text-primary,#192120) 82%,var(--surface-1,#fff))}@media(max-width:600px){.ds-summary{padding:12px}}"
    },
    {
      "name": "曲目行",
