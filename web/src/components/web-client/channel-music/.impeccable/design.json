      "html": "<button class=\"ds-btn ds-saved\">我的歌单 <small>网易云</small></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:7px 9px;border:1px solid var(--border,#e4ece9);border-radius:7px;background:transparent;color:var(--text-primary,#192120);font:inherit;cursor:pointer}.ds-btn:hover:not(:disabled){background:var(--surface-2,#f1f6f4)}.ds-btn:focus-visible{outline:2px solid var(--accent,#006a64);outline-offset:3px}.ds-btn:disabled{opacity:.45;cursor:default}@media(max-width:600px){.ds-btn{min-height:44px}}.ds-saved{max-width:210px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.ds-saved small{font-size:10px;color:color-mix(in srgb,var(--text-primary,#192120) 82%,var(--surface-1,#fff))}"
    },
    {
      "name": "播放器表面",
